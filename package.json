		"@sveltejs/kit": "^2.20.1",
		"@sveltejs/vite-plugin-svelte": "^4.0.0-next.6",
		"@types/eslint": "^9.6.0",
		"@types/js-cookie": "^3.0.6",
		"@types/jsonwebtoken": "^9.0.6",
		"@types/node": "^22.5.2",
		"autoprefixer": "^10.4.21",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.36.0",
		"globals": "^15.0.0",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.1.2",
