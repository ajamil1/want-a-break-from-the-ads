		"axios": "^1.7.7",
		"cookie": "^0.6.0",
		"dotenv": "^16.4.5",
		"fast-levenshtein": "^3.0.0",
		"fuse.js": "^7.0.0",
		"fuzzysearch": "^1.0.3",
		"googleapis": "^144.0.0",
