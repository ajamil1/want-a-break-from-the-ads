// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"  // This creates the SQLite database file in the `prisma` folder
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String   @id @default(uuid())  // Unique user ID
  accessToken     String   // Store the access token
  maxAge          Int      @default(0)
  createdAt       DateTime @default(now())      // Date the user was created
}
